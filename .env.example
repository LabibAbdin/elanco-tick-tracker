# Copy to .env and adjust. Every value shown is the default.

# --- storage ---
# DATABASE_URL=sqlite:///data/ticks.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ticks

# --- upstream ---
UPSTREAM_BASE_URL=https://dev-task.elancoapps.com/data
HTTP_CONNECT_TIMEOUT_S=5
HTTP_READ_TIMEOUT_S=20
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_S=0.5
HTTP_BACKOFF_CAP_S=8
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_S=60
PARTITION_CONCURRENCY=4

# --- ingestion ---
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=60
BATCH_SIZE=500
DUPLICATE_WINDOW_S=300
MIN_VALID_YEAR=1990

# --- API ---
CORS_ORIGINS=*
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
# ADMIN_API_KEY=change-me        # when set, POST /api/v1/ingestion/sync requires X-API-Key
LOG_LEVEL=INFO
LOG_JSON=true
